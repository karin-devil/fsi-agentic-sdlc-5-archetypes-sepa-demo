{
  "name": "Antigravity-Business (EuroBank CAPCom A-23 PO & Test Analyst Profile)",
  "version": "2026.09",
  "targetAudience": "1,500 EuroBank Product Owners, Business Analysts & Test Analysts",
  "settings": {
    "antigravity.ui.mode": "business-analyst",
    "antigravity.agent.defaultPersona": "coba-01-sentinel-spec-refiner",
    "antigravity.agent.secondaryPersona": "coba-03-opaque-e2e-test-architect",
    "antigravity.skills.pinned": [
      "/pm-grill-me",
      "/write-prd",
      "/red-team-prd",
      "/coba-bdd-synthesizer"
    ],
    "workbench.activityBar.visible": true,
    "git.decorations.enabled": false,
    "debug.toolBarLocation": "hidden",
    "http.proxySupport": "override",
    "antigravity.security.lane": "lane-1-synthetic-guardrailed",
    "antigravity.hooks.configPath": ".agents/hooks.json"
  }
}
